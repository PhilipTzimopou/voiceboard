<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Χτίζει και σε Mac (για έλεγχο του κώδικα)· η εφαρμογή τρέχει μόνο σε Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Company>Philip Tzimopou</Company>
    <Product>Voiceboard</Product>
  </PropertyGroup>
</Project>
